{
  "name": "@ibnlanre/cipher",
  "description": "AES encryption and decryption for browsers, workers and Node, with no Node polyfills",
  "version": "3.0.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "encrypt",
    "decrypt",
    "AES",
    "encode",
    "decode",
    "cipher",
    "hash",
    "security"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "browserslist": "> 0.25%, not dead",
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibnlanre/cipher.git"
  },
  "engines": {
    "node": ">=20"
  }
}
